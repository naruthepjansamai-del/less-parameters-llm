-- Tween helper
local function tweenObject(obj, props, time)
    local info = TweenInfo.new(time or 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService:Create(obj, info, props):Play()
end

-- Noclip logic
local noclipEnabled = false
local conn

local function setCollision(character, value)
    if not character then return end
    for _, part in pairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            part.CanCollide = value
        end
    end
end

local function enableNoclip()
    local char = player.Character
    if not char then return end
    setCollision(char, false)

    conn = RunService.RenderStepped:Connect(function()
        if not player.Character then return end
        for _, part in pairs(player.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.CanCollide = false
            end
        end
    end)
end

local function disableNoclip()
    if conn then
        conn:Disconnect()
        conn = nil
    end
    setCollision(player.Character, true)
end

local function updateUI()
    if noclipEnabled then
        status.Text = "Status: ON"
        tweenObject(dot, {BackgroundColor3 = Color3.fromRGB(60,200,120)}, 0.12)
        tweenObject(toggleBtn, {BackgroundColor3 = Color3.fromRGB(30,90,60)}, 0.18)
        toggleBtn.Text = "Disable Noclip (F)"
    else
        status.Text = "Status: OFF"
        tweenObject(dot, {BackgroundColor3 = Color3.fromRGB(180,50,50)}, 0.12)
        tweenObject(toggleBtn, {BackgroundColor3 = Color3.fromRGB(40,40,55)}, 0.18)
        toggleBtn.Text = "Enable Noclip (F)"
    end
end

local function toggleNoclip()
    noclipEnabled = not noclipEnabled
    if noclipEnabled then
        enableNoclip()
    else
        disableNoclip()
    end
    updateUI()
end

-- Button connections
toggleBtn.MouseButton1Click:Connect(toggleNoclip)
mobileBtn.MouseButton1Click:Connect(toggleNoclip)

-- Hotkey
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode == Enum.KeyCode.F then
            toggleNoclip()
        end
    end
end)

-- Respawn handling
player.CharacterAdded:Connect(function(char)
    task.wait(0.1)
    if noclipEnabled then
        enableNoclip()
    else
        disableNoclip()
    end
end)

-- Double-click header to minimize
local lastClick = 0
header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        local now = tick()
        if now - lastClick < 0.25 then
            if frame.Size.Y.Offset > 40 then
                tweenObject(frame, {Size = UDim2.new(0,220,0,38)}, 0.18)
            else
                tweenObject(frame, {Size = UDim2.new(0,220,0,110)}, 0.18)
            end
        end
        lastClick = now
    end
end)
